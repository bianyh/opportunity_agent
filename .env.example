# Copy this file to .env, then put your own key after the equals sign.
# .env is intentionally ignored by Git. Do not paste a real key into this example.
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://yibuapi.com/v1
LLM_MODEL=gpt-5.5

# Chat ReAct host + local Opportunity A2A worker.
A2A_ENABLED=1
OPPORTUNITY_A2A_URL=http://127.0.0.1:8770/a2a/jsonrpc/
OPPORTUNITY_A2A_HOST=127.0.0.1
OPPORTUNITY_A2A_PORT=8770
OPPORTUNITY_A2A_TIMEOUT_SECONDS=45

# Optional: long-form planning response limits.
# Total budget covers the first detailed draft and a possible compact repair.
# ROADMAP_LLM_TIMEOUT_SECONDS=210
# ROADMAP_ARTICLE_MAX_TOKENS=2400

# Official university research. The default provider reads only registered
# university HTTPS domains and does not require a third-party search key.
# Set RESEARCH_WEB_ENABLED=0 only when deliberately disabling fresh retrieval.
RESEARCH_WEB_ENABLED=1
RESEARCH_WEB_PROVIDER=official
# Optional Tavily accelerator. It is not required for official retrieval.
# TAVILY_API_KEY=tvly-your-key-here
# RESEARCH_WEB_PROVIDER=tavily
# OFFICIAL_SEARCH_URL=https://www.google.com/search
# OFFICIAL_CACHE_TTL_HOURS=168
# OFFICIAL_TOOL_MAX_CALLS=6
# OFFICIAL_RESEARCH_TIMEOUT_SECONDS=60

# Optional resume enhancement. Separate from LLM_API_KEY. Never commit real tokens.
# MINERU_API_TOKEN=your-mineru-token
# RESUME_PARSE_TIMEOUT_SECONDS=120
# Total budget for a resume extraction job. Long resumes are split into small calls.
# RESUME_LLM_TIMEOUT_SECONDS=120
# RESUME_LLM_MAX_TOKENS=2600
# V2 authentication: generate a private random secret before using Compose.
# JWT_SECRET=<at-least-32-random-characters>
# Optional preference embeddings. Rules remain available if the model fails.
# MEMORY_VECTOR_ENABLED=1

# Final-answer transport: transient errors retry once within the stage/run budget.
SYNTHESIZER_TIMEOUT_SECONDS=60
SYNTHESIZER_RETRIES=1
SYNTHESIZER_BUDGET_SECONDS=90
SYNTHESIZER_MAX_TOKENS=1400
# Verified structured facts commit synchronously; full-text/vector work is optional.
RESEARCH_PERSIST_FACTS=1
RESEARCH_QUEUE_INGEST=0

# Research: overhead + per-school allowance, with bounded total and page work.
# Empty uses 60s for legacy, 90s when tool repair is enabled.
RESEARCH_PER_SCHOOL_SECONDS=
RESEARCH_TOOL_REPAIR_ENABLED=0
RESEARCH_AGENT_ENABLED=1
RESEARCH_AGENT_MODEL_TIMEOUT_SECONDS=110
RESEARCH_AGENT_REASONING_EFFORT=low
RESEARCH_AGENT_BUDGET_SECONDS=300
RESEARCH_AGENT_MAX_STEPS=5
# Model-owned question planning/tool loop; the legacy task parser is available
# only with RESEARCH_AGENT_ENABLED=0. Search uses public Bing RSS, while official
# page links and model-proposed URLs remain bounded, domain-checked candidates.
# Optional: gateway-supported repair planner model; otherwise inherit global model.
# RESEARCH_REPAIR_MODEL=<gateway-supported-model>
RESEARCH_OVERHEAD_SECONDS=15
RESEARCH_MAX_BUDGET_SECONDS=600
RESEARCH_DISCOVERY_SCHOOL_COUNT=10
RESEARCH_EXTRACT_TIMEOUT_SECONDS=30
RESEARCH_TARGET_MAX_ATTEMPTS=3
RESEARCH_PROGRESS_ENABLED=1
RESEARCH_EXTRACT_FAILURE_LIMIT=3
RESEARCH_READ_FALLBACK=1
# Optional: a fast extraction model offered by YOUR existing gateway (same key/base).
# RESEARCH_EXTRACT_MODEL=<gateway-supported-model>
# Optional only if the gateway/model supports this parameter; leave unset otherwise.
# RESEARCH_EXTRACT_REASONING_EFFORT=low
# Optional shared fast model for parsing, discovery, extraction and repair.
# Role-specific overrides win. Unset inherits global model for backwards compatibility.
RESEARCH_FAST_MODEL=
RESEARCH_PARSE_MODEL=
RESEARCH_DISCOVERY_MODEL=
RESEARCH_REPAIR_MODEL=
RESEARCH_EXTRACT_MODEL=
# Section/block input bound; keyword selection is preprocessing, NOT fact extraction.
RESEARCH_EXTRACT_CONTEXT_CHARS=5000
# prompt | json_object | json_schema. Some gateways stall on response_format=json_object.
RESEARCH_EXTRACT_OUTPUT_MODE=prompt
# Proxy for official page reads only, not internal A2A/PostgreSQL/Redis calls.
# Docker Desktop: Clash Verge must allow LAN access; test this address first.
# RESEARCH_WEB_PROXY=http://host.docker.internal:7897
# Complete run: overhead + Research allowance * maximum rounds (currently 3).
EXECUTION_OVERHEAD_SECONDS=180
EXECUTION_MAX_BUDGET_SECONDS=1800
